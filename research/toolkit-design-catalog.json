{
  "version": "design-catalog-2026-11-09",
  "kind": "research_design_not_executable_method_registry",
  "principle": "每项能力共用一个工具 ID，复用现有代码。模型适配、任务配置和算法方法分别登记。",
  "design_document": "research/wsp-toolkit-tool-design.md",
  "portability": {
    "capability_discovery": "describe_model",
    "boundary": "适配器登记站点、张量轴、输入输出和运行能力。分析方法按输入产物及权限开放。",
    "validation_matrix": [
      {
        "architecture": "llama",
        "scope": "attention_rollout",
        "status": "verified",
        "example": "examples/mcp_attention_rollout.py"
      },
      {
        "architecture": "qwen3",
        "scope": "attention_rollout",
        "status": "verified",
        "example": "examples/mcp_attention_rollout.py"
      },
      {
        "architecture": "qwen3_5",
        "scope": "hybrid_attention_observation",
        "status": "verified_backend",
        "evidence": "research/qwen35-observation-study.md"
      },
      {
        "architecture": "distilbert",
        "scope": "sequence_classification_snapshot_and_probe",
        "status": "verified",
        "checkpoint": "distilbert/distilbert-base-uncased-finetuned-sst-2-english",
        "example": "examples/mcp_classification.py"
      }
    ]
  },
  "interfaces": {
    "agent_protocol": "MCP",
    "research_api": "Python",
    "shared_tool_definitions": true,
    "shared_python_execution": true,
    "mcp_status": "local_permission_profiles",
    "mcp_discovery": "tools/list",
    "mcp_call": "tools/call",
    "default_profile": "read_only",
    "initial_read_only_flow": [
      "describe_model",
      "model_forward",
      "read_artifact"
    ],
    "available_mcp_tools": [
      "describe_model",
      "model_forward",
      "read_artifact",
      "list_tensors",
      "read_tensor",
      "get_run",
      "analyze_weight_delta",
      "compare_models",
      "extract_features",
      "score_preferences",
      "scan_lens"
    ],
    "capability_dependent_mcp_tools": {
      "trace_circuit": "注意力分析需连续可观测的普通自注意力。路径替换和 ACDC 需 Llama 或 Qwen3 和临时干预授权，EAP 另需梯度授权。特征归因需梯度授权、Circuit Tracer 环境和绑定版本的逐层特征字典。见 describe_model.trace_circuit_methods。",
      "compress_model": "需要编辑授权。Taylor 另需梯度授权与训练数据。GPTQ 和 AWQ 需登记独立 LLM Compressor 环境，SliceGPT 需独立上游环境和 Llama 检查点。",
      "edit_facts": "需登记独立 EasyEdit 环境和源码，开放编辑与梯度权限。接入口面向 Llama 和 Qwen3，真实验证覆盖 SmolLM2。"
    },
    "opt_in_mcp_tools": {
      "edit": [
        "create_patch",
        "apply_patch",
        "revert_patch",
        "export_patch",
        "import_patch",
        "export_model",
        "project_weight",
        "merge_updates",
        "prune_and_compensate",
        "compress_update",
        "compress_model",
        "edit_facts"
      ],
      "intervene": [
        "run_intervention",
        "localize_behavior",
        "trace_circuit.path_patching",
        "trace_circuit.acdc",
        "trace_circuit.eap"
      ],
      "evaluate": [
        "evaluate_variants"
      ],
      "gradient": [
        "attribute_output",
        "trace_circuit.eap",
        "trace_circuit.feature_attribution_graph"
      ],
      "train": [
        "train_update"
      ],
      "python": [
        "execute_python"
      ]
    },
    "optional_dependency_tools": {
      "analysis": [
        "render_evidence",
        "probe_representation",
        "trace_circuit.attention_flow"
      ],
      "concepts": [
        "probe_representation.fit_eraser",
        "run_intervention.concept_erasure"
      ],
      "gradients": [
        "attribute_output"
      ],
      "peft": [
        "train_update",
        "host_native_adapter_import"
      ]
    }
  },
  "status_definitions": {
    "agent_tool": "现有原作分发器已提供此入口。",
    "reuse_and_expose": "核心功能或可执行脚本已存在，计划共用接口。",
    "extend_existing": "复用现有服务，补充新的计算方法。",
    "new_method": "核心方法尚待接入或实现。",
    "local_read_only": "当前源码的只读服务已提供此入口。",
    "host_registration": "由宿主在 Python 或 MCP 启动时登记模型。",
    "local_opt_in": "当前本地服务在宿主明确授权后提供此入口。",
    "local_analysis_extra": "当前本地服务安装 analysis 可选依赖后提供此入口。",
    "host_development_dataset": "宿主明确登记开发数据后提供此入口。"
  },
  "legacy_design_names": {
    "run_forward": "model_forward",
    "run_python": "execute_python",
    "capture_activations": "model_forward: observation option",
    "train_role_update": "train_update"
