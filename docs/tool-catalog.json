{
  "version": "design-catalog-2026-11-09",
  "kind": "research_design_not_executable_method_registry",
  "principle": "Each capability shares one tool ID and reuses existing code. Model adapters, task configurations, and algorithmic methods are registered separately.",
  "design_document": "docs/tool-design.md",
  "portability": {
    "capability_discovery": "describe_model",
    "boundary": "Adapters register sites, tensor axes, inputs, outputs, and runtime capabilities. Analysis methods are exposed according to input artifacts and permissions.",
    "validation_matrix": [
      {
        "architecture": "llama",
        "scope": "attention_rollout",
        "status": "verified",
        "example": "examples/mcp_attention_rollout.py"
      },
      {
        "architecture": "qwen3",
        "scope": "attention_rollout",
        "status": "verified",
        "example": "examples/mcp_attention_rollout.py"
      },
      {
        "architecture": "qwen3_5",
        "scope": "hybrid_attention_observation",
        "status": "verified_backend",
        "evidence": "research/reports/qwen35-observation-study.md"
      },
      {
        "architecture": "distilbert",
        "scope": "sequence_classification_snapshot_and_probe",
        "status": "verified",
        "checkpoint": "distilbert/distilbert-base-uncased-finetuned-sst-2-english",
        "example": "examples/mcp_classification.py"
      }
    ]
  },
  "interfaces": {
    "agent_protocol": "MCP",
    "research_api": "Python",
    "shared_tool_definitions": true,
    "shared_python_execution": true,
    "mcp_status": "local_permission_profiles",
    "mcp_discovery": "tools/list",
    "mcp_call": "tools/call",
    "default_profile": "read_only",
    "initial_read_only_flow": [
      "describe_model",
      "model_forward",
      "read_artifact"
    ],
    "available_mcp_tools": [
      "describe_model",
      "model_forward",
      "read_artifact",
      "list_tensors",
      "read_tensor",
      "get_run",
      "analyze_weight_delta",
      "compare_models",
      "extract_features",
      "score_preferences",
      "scan_lens"
    ],
    "capability_dependent_mcp_tools": {
      "trace_circuit": "Attention analysis requires continuously observable standard self-attention. Path patching and ACDC require Llama or Qwen3 and intervention permission; EAP also requires gradient permission. Feature attribution requires gradient permission, a Circuit Tracer environment, and per-layer feature dictionaries bound to the model version. See describe_model.trace_circuit_methods.",
      "compress_model": "Requires edit permission. Taylor also requires gradient permission and training data. GPTQ and AWQ require a registered separate LLM Compressor environment; SliceGPT requires a separate upstream environment and a Llama checkpoint.",
      "edit_facts": "Requires a registered separate EasyEdit environment and source, plus edit and gradient permissions. The interface targets Llama and Qwen3; real-model validation covers SmolLM2."
    },
    "opt_in_mcp_tools": {
      "edit": [
        "create_patch",
        "apply_patch",
        "revert_patch",
        "export_patch",
        "import_patch",
        "export_model",
        "project_weight",
        "merge_updates",
        "prune_and_compensate",
        "compress_update",
        "compress_model",
        "edit_facts"
      ],
      "intervene": [
        "run_intervention",
        "localize_behavior",
        "trace_circuit.path_patching",
        "trace_circuit.acdc",
        "trace_circuit.eap"
      ],
      "evaluate": [
        "evaluate_variants"
      ],
      "gradient": [
        "attribute_output",
        "trace_circuit.eap",
        "trace_circuit.feature_attribution_graph"
      ],
      "train": [
        "train_update"
      ],
      "python": [
        "execute_python"
      ]
    },
    "optional_dependency_tools": {
      "analysis": [
        "render_evidence",
        "probe_representation",
        "trace_circuit.attention_flow"
      ],
      "concepts": [
        "probe_representation.fit_eraser",
        "run_intervention.concept_erasure"
      ],
      "gradients": [
        "attribute_output"
      ],
      "peft": [
        "train_update",
        "host_native_adapter_import"
      ]
    }
  },
  "status_definitions": {
    "agent_tool": "The existing original dispatcher provides this entry point.",
    "reuse_and_expose": "Core functionality or executable scripts exist; a shared interface is planned.",
    "extend_existing": "Reuse existing services and add computation methods.",
    "new_method": "The core method remains to be integrated or implemented.",
    "local_read_only": "The current source provides this entry point through the read-only service.",
    "host_registration": "The host registers the model at Python or MCP startup.",
    "local_opt_in": "The current local service provides this entry point with explicit host permission.",
    "local_analysis_extra": "The current local service provides this entry point when the optional analysis dependencies are installed.",
    "host_development_dataset": "This entry point is available after the host explicitly registers development data."
  },
  "legacy_design_names": {
    "run_forward": "model_forward",
    "run_python": "execute_python",
    "capture_activations": "model_forward: observation option",
    "train_role_update": "train_update"
  },
